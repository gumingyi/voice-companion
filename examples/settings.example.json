{
  "version": 4,
  "providers": [
    {
      "id": "deepseek",
      "name": "DeepSeek 官方",
      "protocol": "openai",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-flash",
      "timeout": 60,
      "retries": 1,
      "max_tokens": 1024,
      "temperature": 0.5,
      "enabled": true,
      "fast_mode": true,
      "extra": {
        "thinking": {
          "type": "disabled"
        }
      }
    }
  ],
  "default_provider": "deepseek",
  "fallback_provider": "",
  "template": "scene-1",
  "templates": [
    {
