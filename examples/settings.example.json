  "backgrounds": [
    {
      "id": "default",
      "name": "默认场景",
      "text": ""
    }
  ],
  "background_id": "default",
  "use_background": false,
  "context_chars": 12000,
  "fast_answers": true,
  "fast_history_pairs": 2,
  "audio": {
    "mode": "system",
    "system_device": null,
    "mic_device": null,
    "model_path": "models/vosk-model-small-cn-0.22",
    "silence_ms": 1000,
    "min_speech_ms": 500,
    "max_segment_ms": 60000,
    "rms_threshold": 300,
    "auto_submit": false,
    "manual_capture": true,
    "live_transcription": true,
    "answer_on_pause": true,
    "term_replacements": {
      "史密斯": "Smith",
      "斯密斯": "Smith"
    }
  },
  "mobile": {
    "host": "127.0.0.1",
    "port": 8765,
    "share_transcript": false
  },
  "hotkeys": {
    "listen": "CTRL+ALT+L",
    "submit": "CTRL+ALT+ENTER",
    "cancel": "CTRL+ALT+X",
    "clear": "CTRL+ALT+N",
    "model": "CTRL+ALT+M",
    "window": "CTRL+ALT+H",
    "settings": "CTRL+ALT+S"
  },
  "save_history": false,
  "font_size": 14
}